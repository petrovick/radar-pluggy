{
  "name": "pluggy-connector",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "lint": "eslint .",
    "type-check": "tsc --noEmit",
    "test": "MYSQL_DATABASE=oplab_radar_test vitest run",
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "setup": "node tasks/setup.mjs setup",
    "migrate": "node node_modules/sequelize-cli/lib/sequelize db:migrate --env production",
    "prepare": "husky"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "awilix": "^13.0.5",
    "decimal.js": "^10.4.3",
    "express": "^4.21.1",
    "mysql2": "^3.24.2",
    "pluggy-sdk": "^0.90.0",
    "sequelize": "^6.37.8",
    "sequelize-cli": "^6.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "eslint": "^9.17.0",
    "husky": "^9.1.7",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.69.0",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "qs": "^6.16.0"
  }
}
